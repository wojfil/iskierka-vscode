{
  "name": "iskierka-language",
  "displayName": "Iskierka Language",
  "description": "Syntax highlighting for Iskierka",
  "version": "1.1.0",
  "publisher": "wojfil",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:iskierka"
  ],
  "contributes": {
    "languages": [
      {
        "id": "iskierka",
        "aliases": [
          "Iskierka",
          "iskierka"
        ],
        "extensions": [
          ".iski"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wojfil/iskierka-vscode"
  },
  "license": "MIT"
}
